{
  "default_policy": "ask",
  "servers": {
    "bash": {
      "default": "ask",
      "accept_prefixes": [
        "ls",
        "cat",
        "head",
        "tail",
        "wc",
        "echo",
        "date",
        "pwd",
        "kubectl get",
        "oc get",
        "oc whoami"
      ],
      "reject_prefixes": [
        "rm -rf",
        "mkfs",
        "shutdown",
        "reboot",
        "kubectl delete",
        "oc delete"
      ]
    },
    "files": {
      "default": "ask",
      "tools": {
        "list_files": "accept",
        "read_file": "accept"
      }
    },
    "skills": {
      "default": "accept"
    },
    "kubectl-mtv": {
      "default": "ask",
      "tools": {
        "mtv_read": "accept",
        "mtv_help": "accept"
      }
    },
    "kubectl-debug-queries": {
      "default": "accept"
    },
    "kubectl-metrics": {
      "default": "accept"
    }
  }
}
